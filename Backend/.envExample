```
# ====================================
# 視力檢查系統 Backend 環境變數配置
# ====================================

# ===== 資料庫配置 =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=postgres

# ===== Spring Boot 配置 =====
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=production

# JVM 記憶體配置（根據伺服器記憶體調整）
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# ===== Grok API 配置 (必填) =====
# 從 https://console.x.ai/ 獲取 API Key
GROK_API_KEY=xai-your-api-key-here
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-3-latest

# ===== VectorDB 配置 =====
VECTORDB_HOST=vectordb
VECTORDB_PORT=50051

# ===== 聊天功能配置 =====
# 對話歷史最大訊息數（調整此值可控制記憶體使用）
CHAT_MAX_MESSAGES=20

# 向量搜索返回結果數（影響搜索精度和性能）
VECTOR_SEARCH_TOP_K=5

# ===== 安全配置 =====
# JWT Secret (生產環境請使用強密碼)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ===== 效能調優配置 =====
# PostgreSQL 連接池配置
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000

# ===== 日誌配置 =====
# 日誌等級 (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_DEMO=INFO

# ===== 開發環境專用 =====
# 開發模式時啟用以下配置
# SPRING_PROFILES_ACTIVE=development
# LOGGING_LEVEL_COM_EXAMPLE_DEMO=DEBUG
# SPRING_JPA_SHOW_SQL=true

# ===== 生產環境專用 =====
# 生產模式建議配置
# SPRING_PROFILES_ACTIVE=production
# JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:+UseContainerSupport
# POSTGRES_PASSWORD=your-ultra-secure-production-password
```